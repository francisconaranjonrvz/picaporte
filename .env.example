# Copia a .env para desarrollo local. Nunca se versiona.
DJANGO_SETTINGS_MODULE=config.settings.local
DEBUG=True
SECRET_KEY=dev-insecure-change-me
DATABASE_URL=sqlite:///db.sqlite3
# Solo si quieres correr los tests contra Postgres en local (por defecto: SQLite en memoria).
# TEST_DATABASE_URL=postgres://picaporte:picaporte@localhost:5432/picaporte_test
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=

# Usuario único (lo crea `manage.py ensure_user`)
PICAPORTE_USER=laura
PICAPORTE_PASSWORD=
PICAPORTE_EMAIL=

# IA (fase 2: parseo del CV; fase 4: enriquecimiento). Sin clave, la app funciona pero sin IA.
# Proveedor gratuito por defecto: clave nvapi-... de https://build.nvidia.com
NVIDIA_API_KEY=
# LLM_PROVIDER=nvidia            # o "anthropic" (de pago) con ANTHROPIC_API_KEY
# LLM_MODEL=google/gemma-4-31b-it   # alternativa: openai/gpt-oss-20b
# LLM_MODEL_FAST=nvidia/nemotron-3.5-lightning-30b-a3b   # enriquecimiento de webs (volumen)
# LLM_TIMEOUT=90

# Botón "Buscar nuevas empresas": PAT fine-grained con permiso Actions: write sobre el repo
GITHUB_DISPATCH_TOKEN=
# GITHUB_REPO=francisconaranjonrvz/picaporte
# GITHUB_WORKFLOW_REF=main

# Foursquare OS Places: token de lectura de Hugging Face con las condiciones del dataset
# foursquare/fsq-os-places aceptadas. Solo lo usa `discover` (necesita `uv sync --group worker`).
# HF_TOKEN=
